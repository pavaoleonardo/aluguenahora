# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Build snapshots and copies (.next.bak, .next.old, ...) must stay ignored:
# Tailwind scans every non-ignored file as plain text, and a snapshot keeps the
# prerendered HTML where React writes class="... bg-[url(&#x27;/img-2.jpg&#x27;)] ...".
# Tailwind turns that into a broken url() rule and `next build` aborts with
# "Module not found". Proven cause of the failed production build on 2026-09-30.
/.next*
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

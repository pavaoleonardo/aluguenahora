{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singleton": false,
    "pluralName": "users",
    "singularName": "user",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false,
    "timestamps": true
  },
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 3,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inverse": "users",
      "configurable": false
    },
    "nome_completo": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "celular": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "cnpj": {
      "type": "string"
    },
    "tipo_usuario": {
      "type": "enumeration",
      "enum": [
        "proprietario",
        "corretor",
        "imobiliaria"
      ]
    },
    "creci": {
      "type": "string"
    },
    "nome_imobiliaria": {
      "type": "string"
    },
    "rg": {
      "type": "string"
    },
    "data_nascimento": {
      "type": "string"
    },
    "creci_uf": {
      "type": "string"
    },
    "nome_profissional": {
      "type": "string"
    },
    "vinculo_profissional": {
      "type": "string"
    },
    "creci_imobiliaria": {
      "type": "string"
    },
    "telefone_alternativo": {
      "type": "string"
    },
    "cep": {
      "type": "string"
    },
    "logradouro": {
      "type": "string"
    },
    "numero": {
      "type": "string"
    },
    "complemento": {
      "type": "string"
    },
    "bairro": {
      "type": "string"
    },
    "cidade": {
      "type": "string"
    },
    "estado": {
      "type": "string"
    },
    "razao_social": {
      "type": "string"
    },
    "nome_fantasia": {
      "type": "string"
    },
    "inscricao_estadual": {
      "type": "string"
    },
    "data_fundacao": {
      "type": "string"
    },
    "site": {
      "type": "string"
    },
    "representante_nome": {
      "type": "string"
    },
    "representante_cargo": {
      "type": "string"
    },
    "representante_cpf": {
      "type": "string"
    },
    "representante_rg": {
      "type": "string"
    },
    "representante_data_nascimento": {
      "type": "string"
    }
  }
}
